              },
              "editorMode": "code",
              "expr": "histogram_quantile(0.50, sum by (le) (increase(inventory_product_search_latency_bucket_total{service=\"inventory-api\", env=\"$env\", module=\"$module\"}[5m])))",
              "legendFormat": "p50",
              "refId": "A",
              "range": true
            },
            {
              "datasource": {
                "type": "prometheus",
                "uid": "${DS_PROMETHEUS}"
              },
              "editorMode": "code",
              "expr": "histogram_quantile(0.95, sum by (le) (increase(inventory_product_search_latency_bucket_total{service=\"inventory-api\", env=\"$env\", module=\"$module\"}[5m])))",
              "legendFormat": "p95",
              "refId": "B",
