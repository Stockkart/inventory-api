          },
          "editorMode": "code",
          "expr": "sum by (method, uri, status) (increase(inventory_api_requests_total{service=\"inventory-api\", env=\"$env\", module=\"$module\", uri=~\".+\", method!=\"OPTIONS\", status=~\"[45]..\"}[5m]))",
          "legendFormat": "{{method}} {{uri}} {{status}}",
          "refId": "A",
          "range": true
        }
      ]
    },
    {
      "id": 99,
      "type": "row",
      "title": "Search",
      "collapsed": true,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 28
      },
      "panels": [
        {
          "id": 100,
          "type": "timeseries",
          "title": "Searches / 5 min by surface and outcome",
          "description": "How many searches ran and how they ended. ok = answered; timeout = hit the 3 s limit; regex_rejected = unsafe regular expression refused; validation_error = bad request; error = unexpected failure.",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "gridPos": {
            "h": 8,
            "w": 12,
            "x": 0,
            "y": 29
          },
          "fieldConfig": {
            "defaults": {
              "color": {
                "mode": "palette-classic"
              },
              "custom": {
                "axisBorderShow": false,
                "axisCenteredZero": false,
                "drawStyle": "line",
                "fillOpacity": 8,
                "gradientMode": "none",
                "lineWidth": 1,
                "pointSize": 5,
                "showPoints": "never",
                "spanNulls": false,
                "stacking": {
                  "group": "A",
                  "mode": "normal"
                }
              },
              "unit": "short"
            },
            "overrides": []
          },
          "options": {
            "legend": {
              "calcs": [
                "mean",
                "lastNotNull"
              ],
              "displayMode": "table",
              "placement": "bottom",
              "showLegend": true
            },
            "tooltip": {
              "mode": "multi",
              "sort": "desc"
            }
          },
          "targets": [
            {
              "datasource": {
                "type": "prometheus",
                "uid": "${DS_PROMETHEUS}"
              },
              "editorMode": "code",
              "expr": "sum by (surface, outcome) (increase(inventory_product_search_requests_total{service=\"inventory-api\", env=\"$env\", module=\"$module\"}[5m]))",
              "legendFormat": "{{surface}} {{outcome}}",
              "refId": "A",
              "range": true
            }
          ]
        },
        {
          "id": 101,
          "type": "timeseries",
          "title": "Search latency p50 / p95 / p99",
          "description": "Wall time of a search end to end (validate, query, load the page, enrich). Target: p95 under 300 ms.",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "gridPos": {
            "h": 8,
            "w": 12,
            "x": 12,
            "y": 29
          },
          "fieldConfig": {
            "defaults": {
              "color": {
                "mode": "palette-classic"
              },
              "custom": {
                "axisBorderShow": false,
                "axisCenteredZero": false,
                "drawStyle": "line",
                "fillOpacity": 8,
                "gradientMode": "none",
                "lineWidth": 1,
                "pointSize": 5,
                "showPoints": "never",
                "spanNulls": false,
                "stacking": {
                  "group": "A",
                  "mode": "none"
                }
              },
              "unit": "ms"
            },
            "overrides": []
          },
          "options": {
            "legend": {
              "calcs": [
                "mean",
                "lastNotNull"
              ],
              "displayMode": "table",
              "placement": "bottom",
              "showLegend": true
            },
            "tooltip": {
              "mode": "multi",
              "sort": "desc"
            }
          },
          "targets": [
            {
              "datasource": {
                "type": "prometheus",
