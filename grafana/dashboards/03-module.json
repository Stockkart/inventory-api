          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le, method, uri) (increase(inventory_http_latency_bucket_total{service=\"inventory-api\", env=\"$env\", module=\"$module\", method!=\"OPTIONS\"}[5m])))",
          "legendFormat": "{{method}} {{uri}}",
          "refId": "A",
