{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Bind at import to grafanacloud-myntrackofficial-prom",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "10.0.0"
    },
    {
      "type": "datasource",
      "id": "prometheus",
      "name": "Prometheus",
      "version": "1.0.0"
    },
    {
      "type": "panel",
      "id": "timeseries",
      "name": "Time series",
      "version": ""
    },
    {
      "type": "panel",
      "id": "table",
      "name": "Table",
      "version": ""
    }
  ],
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "HTTP (by route)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "table",
      "title": "Endpoints (method + URI)",
      "description": "Reqs = total calls in the selected range. RPM = average requests per minute over that same range.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Avg"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "decimals",
                "value": 3
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "P95"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "decimals",
                "value": 3
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "P99"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "decimals",
                "value": 3
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Reqs"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "RPM"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 3
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Error %"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "decimals",
                "value": 2
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "footer": {
          "show": false
        },
        "cellHeight": "sm"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "round(sum by (method, uri) (increase(inventory_api_requests_total{service=\"inventory-api\", env=\"$env\", module=\"$module\", uri=~\".+\", method!=\"OPTIONS\"}[$__range]))) > 0",
          "legendFormat": "{{method}} {{uri}}",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "(sum by (method, uri) (increase(inventory_http_duration_seconds_total{service=\"inventory-api\", env=\"$env\", module=\"$module\", method!=\"OPTIONS\"}[$__range])) / sum by (method, uri) (increase(inventory_api_requests_total{service=\"inventory-api\", env=\"$env\", module=\"$module\", uri=~\".+\", method!=\"OPTIONS\"}[$__range]))) and (sum by (method, uri) (increase(inventory_api_requests_total{service=\"inventory-api\", env=\"$env\", module=\"$module\", uri=~\".+\", method!=\"OPTIONS\"}[$__range])) > 0)",
          "legendFormat": "{{method}} {{uri}}",
          "refId": "B",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le, method, uri) (increase(inventory_http_latency_bucket_total{service=\"inventory-api\", env=\"$env\", module=\"$module\", method!=\"OPTIONS\"}[$__range]))) and (sum by (method, uri) (increase(inventory_api_requests_total{service=\"inventory-api\", env=\"$env\", module=\"$module\", uri=~\".+\", method!=\"OPTIONS\"}[$__range])) > 0)",
          "legendFormat": "{{method}} {{uri}}",
          "refId": "C",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.99, sum by (le, method, uri) (increase(inventory_http_latency_bucket_total{service=\"inventory-api\", env=\"$env\", module=\"$module\", method!=\"OPTIONS\"}[$__range]))) and (sum by (method, uri) (increase(inventory_api_requests_total{service=\"inventory-api\", env=\"$env\", module=\"$module\", uri=~\".+\", method!=\"OPTIONS\"}[$__range])) > 0)",
          "legendFormat": "{{method}} {{uri}}",
          "refId": "D",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "((sum by (method, uri) (increase(inventory_api_requests_total{service=\"inventory-api\", env=\"$env\", module=\"$module\", uri=~\".+\", method!=\"OPTIONS\", status=~\"[45]..\"}[$__range])) or (sum by (method, uri) (increase(inventory_api_requests_total{service=\"inventory-api\", env=\"$env\", module=\"$module\", uri=~\".+\", method!=\"OPTIONS\"}[$__range])) * 0)) / sum by (method, uri) (increase(inventory_api_requests_total{service=\"inventory-api\", env=\"$env\", module=\"$module\", uri=~\".+\", method!=\"OPTIONS\"}[$__range]))) and (sum by (method, uri) (increase(inventory_api_requests_total{service=\"inventory-api\", env=\"$env\", module=\"$module\", uri=~\".+\", method!=\"OPTIONS\"}[$__range])) > 0)",
          "legendFormat": "{{method}} {{uri}}",
          "refId": "E",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "(sum by (method, uri) (rate(inventory_api_requests_total{service=\"inventory-api\", env=\"$env\", module=\"$module\", uri=~\".+\", method!=\"OPTIONS\"}[$__range])) * 60) and (sum by (method, uri) (increase(inventory_api_requests_total{service=\"inventory-api\", env=\"$env\", module=\"$module\", uri=~\".+\", method!=\"OPTIONS\"}[$__range])) > 0)",
          "legendFormat": "{{method}} {{uri}}",
          "refId": "F",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "Time 2": true,
              "Time 3": true,
              "Time 4": true,
              "Time 5": true
            },
            "renameByName": {
              "Value #A": "Reqs",
              "Value #F": "RPM",
              "Value #B": "Avg",
              "Value #C": "P95",
              "Value #D": "P99",
              "Value #E": "Error %",
              "method": "Method",
              "uri": "URI"
            },
            "indexByName": {
              "Method": 0,
              "URI": 1,
              "Reqs": 2,
              "RPM": 3,
              "Avg": 4,
              "P95": 5,
              "P99": 6,
              "Error %": 7
            }
          }
        },
        {
          "id": "filterByValue",
          "options": {
            "match": "all",
            "type": "include",
            "filters": [
              {
                "fieldName": "Reqs",
                "config": {
                  "id": "greater",
                  "options": {
                    "value": 0
                  }
                }
              }
            ]
          }
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "RPM by route",
      "description": "Average requests per minute (trailing 5 minutes). A spike of 12 requests in 5 min shows as 2.4 RPM.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 11
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "drawStyle": "line",
            "fillOpacity": 8,
            "gradientMode": "none",
            "lineWidth": 1,
            "pointSize": 5,
            "showPoints": "always",
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "none"
            }
          },
          "decimals": 2,
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [
            "mean",
            "lastNotNull"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "sum by (method, uri) (rate(inventory_api_requests_total{service=\"inventory-api\", env=\"$env\", module=\"$module\", uri=~\".+\", method!=\"OPTIONS\"}[5m])) * 60",
          "legendFormat": "{{method}} {{uri}}",
          "refId": "A",
          "range": true
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "p95 latency by route",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 11
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "drawStyle": "line",
            "fillOpacity": 8,
            "gradientMode": "none",
            "lineWidth": 1,
            "pointSize": 5,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "none"
            }
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [
            "mean",
