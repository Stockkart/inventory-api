              ],
              "displayMode": "table",
              "placement": "bottom",
              "showLegend": true
            },
            "tooltip": {
              "mode": "multi",
              "sort": "desc"
            }
          },
          "targets": [
            {
              "datasource": {
                "type": "prometheus",
                "uid": "${DS_PROMETHEUS}"
              },
              "editorMode": "code",
              "expr": "sum by (surface) (increase(inventory_product_search_duration_ms_total{service=\"inventory-api\", env=\"$env\", module=\"$module\"}[5m])) / sum by (surface) (increase(inventory_product_search_requests_total{service=\"inventory-api\", env=\"$env\", module=\"$module\", outcome=\"ok\"}[5m]))",
              "legendFormat": "{{surface}} total",
              "refId": "A",
              "range": true
            },
            {
              "datasource": {
                "type": "prometheus",
                "uid": "${DS_PROMETHEUS}"
