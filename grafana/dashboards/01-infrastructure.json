            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "rate(jvm_gc_memory_allocated_bytes{service=\"inventory-api\", env=\"$env\"}[5m]) or rate(jvm_gc_memory_allocated_bytes_total{service=\"inventory-api\", env=\"$env\"}[5m])",
