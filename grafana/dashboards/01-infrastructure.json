{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Bind at import to grafanacloud-myntrackofficial-prom",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "10.0.0"
    },
    {
      "type": "datasource",
      "id": "prometheus",
      "name": "Prometheus",
      "version": "1.0.0"
    },
    {
      "type": "panel",
      "id": "timeseries",
      "name": "Time series",
      "version": ""
    },
    {
      "type": "panel",
      "id": "stat",
      "name": "Stat",
      "version": ""
    }
  ],
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Memory (container / host)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Memory % of RAM",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic-by-name"
          },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "drawStyle": "line",
            "fillOpacity": 8,
            "gradientMode": "none",
            "lineWidth": 2,
            "pointSize": 5,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "none"
            },
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "min": 0,
          "max": 100,
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 80
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "used / RAM"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#5794F2"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "calcs": [
            "mean",
            "lastNotNull"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "100 * sum(container_memory_anon_bytes{service=\"inventory-api\", env=\"$env\"} or container_memory_anon{service=\"inventory-api\", env=\"$env\"}) / clamp_min((sum(container_memory_limit_bytes{service=\"inventory-api\", env=\"$env\"} or container_memory_limit{service=\"inventory-api\", env=\"$env\"}) or (max(jvm_memory_max_bytes{service=\"inventory-api\", env=\"$env\", area=\"heap\"}) / 0.5)), 1)",
          "legendFormat": "used / RAM",
          "range": true,
          "refId": "A"
        }
      ],
      "description": "Same formula as DigitalOcean Insights Memory %: anonymous cgroup RSS / RAM limit. Excludes mapped JAR/JDK file cache (that is why working set looked ~83% while DO showed ~65%)."
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "JVM heap used / committed / max",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic-by-name"
          },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "drawStyle": "line",
            "fillOpacity": 8,
            "gradientMode": "none",
            "lineWidth": 1,
            "pointSize": 5,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "none"
            }
          },
          "unit": "bytes"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "used"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#73BF69"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "committed"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#FF9830"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "max"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#F2495C"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "calcs": [
            "mean",
            "lastNotNull"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "sum(jvm_memory_used_bytes{service=\"inventory-api\", env=\"$env\", area=\"heap\"})",
          "legendFormat": "used",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "sum(jvm_memory_committed_bytes{service=\"inventory-api\", env=\"$env\", area=\"heap\"})",
          "legendFormat": "committed",
          "range": true,
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "sum(jvm_memory_max_bytes{service=\"inventory-api\", env=\"$env\", area=\"heap\"})",
          "legendFormat": "max",
          "range": true,
          "refId": "C"
        }
      ],
      "description": "Committed is reserved from the OS. Max is -XX:MaxRAMPercentage (50% of container/host RAM). If committed only rises, G1 is not uncommitting. If old-gen live data ratchets up, that is a leak."
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "JVM non-heap (Metaspace / code)",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic-by-name"
          },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "drawStyle": "line",
            "fillOpacity": 8,
            "gradientMode": "none",
            "lineWidth": 1,
            "pointSize": 5,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "none"
            }
          },
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [
            "mean",
            "lastNotNull"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "jvm_memory_used_bytes{service=\"inventory-api\", env=\"$env\", area=\"nonheap\"}",
          "legendFormat": "{{id}}",
          "range": true,
          "refId": "A"
        }
      ],
      "description": "Metaspace/CodeHeap grow with classload and JIT. A climb that never drops is a classloader leak."
    },
    {
      "id": 24,
      "type": "row",
      "title": "RAM breakdown",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "panels": []
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "Why RAM is full",
      "description": "Colored bands should add up to anonymous RSS (the DigitalOcean Memory % numerator). other = anon minus named JVM slices. RAM limit is cgroup max or heap max / 0.5.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 0,
        "y": 10
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic-by-name"
          },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "drawStyle": "line",
            "fillOpacity": 40,
            "gradientMode": "none",
            "lineWidth": 1,
            "pointSize": 5,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "normal"
            }
          },
          "unit": "bytes",
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "heap committed"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#5794F2"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "metaspace"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#B877D9"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "compressed class"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#FF9830"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "code cache (JIT)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#73BF69"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "thread stacks"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#F2CC0C"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "direct buffers"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#8AB8FF"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "other (native)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#8A8A8A"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "RAM limit"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#F2495C"
                }
              },
              {
                "id": "custom.stacking",
                "value": {
                  "group": "A",
                  "mode": "none"
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              },
              {
                "id": "custom.lineWidth",
                "value": 2
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    6,
                    4
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "calcs": [
            "mean",
            "lastNotNull"
          ],
          "displayMode": "table",
          "placement": "right",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "sum(jvm_memory_committed_bytes{service=\"inventory-api\", env=\"$env\", area=\"heap\"})",
          "legendFormat": "heap committed",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "sum(jvm_memory_used_bytes{service=\"inventory-api\", env=\"$env\", id=\"Metaspace\"})",
          "legendFormat": "metaspace",
          "range": true,
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "sum(jvm_memory_used_bytes{service=\"inventory-api\", env=\"$env\", id=\"Compressed Class Space\"})",
          "legendFormat": "compressed class",
          "range": true,
          "refId": "C"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "sum(jvm_memory_used_bytes{service=\"inventory-api\", env=\"$env\", id=~\"CodeHeap.*\"})",
          "legendFormat": "code cache (JIT)",
          "range": true,
          "refId": "D"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "(jvm_threads_live_threads{service=\"inventory-api\", env=\"$env\"} or jvm_threads_live{service=\"inventory-api\", env=\"$env\"}) * 1048576",
          "legendFormat": "thread stacks",
          "range": true,
          "refId": "E"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "sum(jvm_buffer_memory_used_bytes{service=\"inventory-api\", env=\"$env\", id=\"direct\"}) or sum(jvm_buffer_memory_used_bytes{service=\"inventory-api\", env=\"$env\"})",
          "legendFormat": "direct buffers",
          "range": true,
          "refId": "F"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "clamp_min(sum(container_memory_anon_bytes{service=\"inventory-api\", env=\"$env\"} or container_memory_anon{service=\"inventory-api\", env=\"$env\"}) - (sum(jvm_memory_committed_bytes{service=\"inventory-api\", env=\"$env\", area=\"heap\"}) + sum(jvm_memory_used_bytes{service=\"inventory-api\", env=\"$env\", area=\"nonheap\"}) + (sum(jvm_threads_live_threads{service=\"inventory-api\", env=\"$env\"} or jvm_threads_live{service=\"inventory-api\", env=\"$env\"}) * 1048576) + (sum(jvm_buffer_memory_used_bytes{service=\"inventory-api\", env=\"$env\", id=\"direct\"}) or sum(jvm_buffer_memory_used_bytes{service=\"inventory-api\", env=\"$env\"}))), 0)",
          "legendFormat": "other (native)",
          "range": true,
          "refId": "G"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "(container_memory_limit_bytes{service=\"inventory-api\", env=\"$env\"} or container_memory_limit{service=\"inventory-api\", env=\"$env\"} or (max(jvm_memory_max_bytes{service=\"inventory-api\", env=\"$env\", area=\"heap\"}) / 0.5))",
          "legendFormat": "RAM limit",
          "range": true,
          "refId": "H"
        }
      ]
    },
    {
      "id": 23,
      "type": "stat",
      "title": "Memory % of RAM",
      "description": "Anonymous RSS / RAM limit — same number DigitalOcean Insights shows as Memory %.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 10
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "min": 0,
          "max": 100,
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 80
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "value",
        "wideLayout": true,
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "showPercentChange": false
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "100 * sum(container_memory_anon_bytes{service=\"inventory-api\", env=\"$env\"} or container_memory_anon{service=\"inventory-api\", env=\"$env\"}) / clamp_min((sum(container_memory_limit_bytes{service=\"inventory-api\", env=\"$env\"} or container_memory_limit{service=\"inventory-api\", env=\"$env\"}) or (max(jvm_memory_max_bytes{service=\"inventory-api\", env=\"$env\", area=\"heap\"}) / 0.5)), 1)",
          "legendFormat": "used / RAM",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ]
    },
