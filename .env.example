DB_URI=
DB_USERNAME=
DB_PASSWORD=
CLIENT_URL=
OCR_PROVIDER=
OCR_OPENAI_MODEL=
OCR_GEMINI_MODEL=
OCR_PREPROCESS_MODE=
OCR_PREPROCESS_URL=
OCR_PREPROCESS_PYTHON_PATH=
OCR_PREPROCESS_WORKING_DIR=
OPENAI_API_KEY=
GEMINI_API_KEY=
AWS_ACCESS_KEY=
AWS_SECRET_ACCESS=
AWS_REGION=
UPLOAD_TOKEN_EXPIRY_MINUTES=
MESSAGING_EMAIL_ENABLED=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=
# Login check remembered per instance (AuthCache) and nightly expired-token cleanup. Keep a value: an empty TTL or size fails boot.
AUTH_CACHE_ENABLED=true
AUTH_CACHE_TTL_SECONDS=60
AUTH_CACHE_MAX_ENTRIES=10000
AUTH_TOKEN_CLEANUP_ENABLED=true
AUTH_TOKEN_CLEANUP_CRON=0 30 3 * * *
# Shop reads remembered per instance (ShopReadCache). Keep a value: an empty TTL or size fails boot.
SHOP_CACHE_ENABLED=true
SHOP_CACHE_TTL_SECONDS=60
SHOP_CACHE_MAX_ENTRIES=10000
# Longest wait (ms) for a free MongoDB connection before answering 503 "busy". Keep a value: empty fails boot.
MONGO_POOL_MAX_WAIT_MS=2000
# MongoDB transactions for the money flows (MongoTx): on/off, attempts after a write conflict,
# ms a shop's flow waits for its turn before 503 "busy"
MONGO_TRANSACTIONS_ENABLED=true
MONGO_TRANSACTIONS_MAX_ATTEMPTS=5
MONGO_TRANSACTIONS_SHOP_WAIT_MS=15000
# Heavy requests per container (HeavyRequestLimiter): run at once, web requests waiting, wait ms
HEAVY_EXPORT_LIMIT=1
HEAVY_EXPORT_QUEUE=3
HEAVY_EXPORT_WAIT_MS=20000
HEAVY_ANALYTICS_LIMIT=3
HEAVY_ANALYTICS_QUEUE=6
HEAVY_ANALYTICS_WAIT_MS=10000
HEAVY_OCR_LIMIT=2
HEAVY_OCR_QUEUE=4
HEAVY_OCR_WAIT_MS=15000
HEAVY_OCR_BACKGROUND_WAIT_MS=300000
HEAVY_IMPORT_LIMIT=1
HEAVY_IMPORT_QUEUE=2
HEAVY_IMPORT_WAIT_MS=20000

# Grafana Cloud (optional — leave empty locally; set on App Platform)
# Metrics: OTLP gateway URL, e.g. https://otlp-gateway-prod-ap-south-1.grafana.net/otlp/v1/metrics
GRAFANA_CLOUD_OTLP_URL=
GRAFANA_CLOUD_OTLP_USER=
# Logs: Loki push URL, e.g. https://logs-prod-028.grafana.net/loki/api/v1/push
GRAFANA_CLOUD_LOKI_URL=
GRAFANA_CLOUD_LOKI_USER=
GRAFANA_CLOUD_API_TOKEN=
SPRING_PROFILES_ACTIVE=local

# Payment gateway (Razorpay Standard Checkout)
PAYMENT_GATEWAY=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# GSTIN verification for vendor/customer forms. Leave GSTIN_PROVIDER unset (or none) to check offline only.
GSTIN_PROVIDER=none
GSTINAPI_KEY=
