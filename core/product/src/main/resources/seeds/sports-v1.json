{
  "verticalId": "sports",
  "version": "1.0.0",
  "entities": {
    "inventory": {
      "fields": [
        {
          "key": "name",
          "label": "Product",
          "type": "string",
          "required": true,
          "storage": "core",
          "showIn": ["registration", "scan-sell", "basic"],
          "validation": { "minLength": 1, "maxLength": 255 }
        },
        {
          "key": "hsn",
          "label": "HSN/SAC",
          "type": "string",
          "required": false,
          "tier": "regular",
          "storage": "core",
          "showIn": ["registration"],
          "validation": { "maxLength": 16, "pattern": "^[0-9]{4,16}$" }
        },
        {
          "key": "baseUnit",
          "label": "Unit",
          "type": "string",
          "required": true,
          "storage": "core",
          "showIn": ["registration", "basic"],
          "validation": { "minLength": 1, "maxLength": 16 }
        },
        {
          "key": "sport",
          "label": "Sport",
          "type": "enum",
          "values": [
            "football",
            "basketball",
            "cricket",
            "baseball",
            "volleyball",
            "athletics",
            "golf",
            "tennis",
            "swimming",
            "gymnastics",
            "boxing",
            "wrestling",
            "judo",
            "taekwondo",
            "mixed martial arts (mma)",
            "surfing",
            "water polo",
            "rowing",
            "diving",
            "sailing",
            "motorcycling",
            "archery",
            "shooting",
            "bowling",
            "darts",
            "gym",
            "badminton",
            "other"
          ],
          "required": true,
          "storage": "extension",
          "indexed": true,
          "searchable": true,
          "sortable": true,
          "showIn": ["registration", "scan-sell", "basic"]
        },
        {
          "key": "sportsType",
          "label": "Sports Type",
          "type": "enum",
          "values": ["equipment", "apparel", "footwear", "accessories", "nutrition", "other"],
          "required": false,
          "storage": "extension",
          "indexed": true,
          "searchable": true,
          "sortable": true,
          "showIn": ["registration", "scan-sell", "basic"]
        },
        {
          "key": "brand",
          "label": "Brand",
          "type": "string",
          "required": true,
          "storage": "extension",
          "indexed": true,
          "searchable": true,
          "sortable": true,
          "showIn": ["registration", "scan-sell", "basic"],
          "validation": { "minLength": 1, "maxLength": 120 }
        },
        {
          "key": "model",
          "label": "Model",
          "type": "string",
          "required": true,
          "storage": "extension",
          "indexed": true,
          "showIn": ["registration", "scan-sell", "basic"],
          "validation": { "minLength": 1, "maxLength": 120 }
        },
        {
          "key": "size",
          "label": "Size",
          "type": "string",
          "required": false,
          "storage": "extension",
          "indexed": true,
          "searchable": true,
          "showIn": ["registration", "scan-sell", "basic"],
          "validation": { "minLength": 1, "maxLength": 32 }
        },
        {
          "key": "warrantyMonths",
          "label": "Warranty (months)",
          "type": "number",
          "required": false,
          "tier": "regular",
          "storage": "extension",
          "indexed": false,
          "showIn": ["registration"],
          "validation": { "min": 0, "max": 120 }
        }
      ],
      "search": {
        "defaultSort": [
          { "field": "brand", "direction": "asc" },
          { "field": "sport", "direction": "asc" }
        ],
        "cursor": "skip"
      }
    }
  }
}
